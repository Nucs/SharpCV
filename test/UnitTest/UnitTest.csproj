<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>

    <IsPackable>false</IsPackable>

    <Platforms>AnyCPU;x64</Platforms>

    <LangVersion>latest</LangVersion>

    <!-- Lifetime tests watch the GC release native leases; tier-0 code reports every local live for a whole method, so
         an object the test dropped would stay rooted and the release would never be observed. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.8.3" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
    <!-- The live parity oracle: opencv-python 4.13 runs in-process through pythonnet, and arrays cross both ways
         without copies. -->
    <PackageReference Include="NumSharp.Interop.pythonnet" Version="0.80.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpCV\SharpCV.csproj" />
  </ItemGroup>

</Project>
